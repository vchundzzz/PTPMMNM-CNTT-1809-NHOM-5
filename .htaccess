DirectoryIndex index.php

RewriteEngine On

# Keep the public URLs short while the source files stay under public/.
RewriteRule ^apple(?:\.php)?$ public/apple.php [L]
RewriteRule ^css/(.*)$ public/css/$1 [L]
RewriteRule ^js/(.*)$ public/js/$1 [L]

# Do not allow the SQLite database to be downloaded from Apache.
RewriteRule ^data(?:/|$) - [F,L]
